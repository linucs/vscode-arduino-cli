{
  "name": "vscode-arduino-cli-ide",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "license": "MIT",
  "publisher": "linucs",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1E1E2E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linucs/vscode-arduino-cli"
  },
  "bugs": {
    "url": "https://github.com/linucs/vscode-arduino-cli/issues"
  },
  "homepage": "https://github.com/linucs/vscode-arduino-cli#readme",
  "keywords": [
    "arduino",
    "arduino-cli",
    "embedded",
    "microcontroller",
    "esp32",
    "avr",
    "stm32",
    "serial-monitor",
    "serial-plotter",
    "debugger",
    "iot",
    "blockly"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:cpp",
    "workspaceContains:**/*.ino"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "arduinoCli.selectBoard",
        "title": "%command.selectBoard%"
      },
      {
        "command": "arduinoCli.compile",
        "title": "%command.compile%",
        "icon": "$(check)"
      },
      {
        "command": "arduinoCli.upload",
        "title": "%command.upload%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "arduinoCli.openMonitor",
        "title": "%command.openMonitor%",
        "icon": "$(plug)"
      },
      {
        "command": "arduinoCli.updateIndex",
        "title": "%command.updateIndex%"
      },
      {
        "command": "arduinoCli.updateLibrariesIndex",
        "title": "%command.updateLibrariesIndex%"
      },
      {
        "command": "arduinoCli.installPlatform",
        "title": "%command.installPlatform%",
        "icon": "$(add)"
      },
      {
        "command": "arduinoCli.uninstallPlatform",
        "title": "%command.uninstallPlatform%"
      },
      {
        "command": "arduinoCli.upgradePlatform",
        "title": "%command.upgradePlatform%"
      },
      {
        "command": "arduinoCli.downloadPlatform",
        "title": "%command.downloadPlatform%"
      },
      {
        "command": "arduinoCli.refreshPlatforms",
        "title": "%command.refreshPlatforms%",
        "icon": "$(refresh)"
      },
      {
        "command": "arduinoCli.upgradePlatforms",
        "title": "%command.upgradePlatforms%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "arduinoCli.platform.uninstall",
        "title": "%command.platformUninstall%",
        "icon": "$(trash)"
      },
      {
        "command": "arduinoCli.platform.upgrade",
        "title": "%command.platformUpgrade%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "arduinoCli.platform.changeVersion",
        "title": "%command.platformChangeVersion%",
        "icon": "$(versions)"
      },
      {
        "command": "arduinoCli.boardDetails",
        "title": "%command.boardDetails%"
      },
      {
        "command": "arduinoCli.uploadUsingProgrammer",
        "title": "%command.uploadUsingProgrammer%"
      },
      {
        "command": "arduinoCli.burnBootloader",
        "title": "%command.burnBootloader%"
      },
      {
        "command": "arduinoCli.newSketch",
        "title": "%command.newSketch%"
      },
      {
        "command": "arduinoCli.archiveSketch",
        "title": "%command.archiveSketch%"
      },
      {
        "command": "arduinoCli.checkForUpdates",
        "title": "%command.checkForUpdates%"
      },
      {
        "command": "arduinoCli.cleanDownloadCache",
        "title": "%command.cleanDownloadCache%"
      },
      {
        "command": "arduinoCli.createProfile",
        "title": "%command.createProfile%"
      },
      {
        "command": "arduinoCli.setDefaultProfile",
        "title": "%command.setDefaultProfile%"
      },
      {
        "command": "arduinoCli.addLibraryToProfile",
        "title": "%command.addLibraryToProfile%"
      },
      {
        "command": "arduinoCli.removeLibraryFromProfile",
        "title": "%command.removeLibraryFromProfile%"
      },
      {
        "command": "arduinoCli.listProfileLibraries",
        "title": "%command.listProfileLibraries%"
      },
      {
        "command": "arduinoCli.debug",
        "title": "%command.debug%",
        "icon": "$(debug-alt)",
        "enablement": "arduinoCli.debugSupported"
      },
      {
        "command": "arduinoCli.debugShowConfig",
        "title": "%command.debugShowConfig%"
      },
      {
        "command": "arduinoCli.configureIntelliSense",
        "title": "%command.configureIntelliSense%"
      },
      {
        "command": "arduinoCli.openPlotter",
        "title": "%command.openPlotter%",
        "icon": "$(graph-line)"
      },
      {
        "command": "arduinoCli.saveSerialLog",
        "title": "%command.saveSerialLog%"
      },
      {
        "command": "arduinoCli.setMonitorLineEnding",
        "title": "%command.setMonitorLineEnding%"
      },
      {
        "command": "arduinoCli.addLibrary",
        "title": "%command.addLibrary%",
        "icon": "$(add)"
      },
      {
        "command": "arduinoCli.upgradeLibraries",
        "title": "%command.upgradeLibraries%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "arduinoCli.refreshLibraries",
        "title": "%command.refreshLibraries%",
        "icon": "$(refresh)"
      },
      {
        "command": "arduinoCli.installLibraryZip",
        "title": "%command.installLibraryZip%"
      },
      {
        "command": "arduinoCli.installLibraryGit",
        "title": "%command.installLibraryGit%"
      },
      {
        "command": "arduinoCli.downloadLibrary",
        "title": "%command.downloadLibrary%"
      },
      {
        "command": "arduinoCli.lib.uninstall",
        "title": "%command.libUninstall%",
        "icon": "$(trash)"
      },
      {
        "command": "arduinoCli.lib.upgrade",
        "title": "%command.libUpgrade%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "arduinoCli.lib.changeVersion",
        "title": "%command.libChangeVersion%",
        "icon": "$(versions)"
      },
      {
        "command": "arduinoCli.lib.openWebsite",
        "title": "%command.libOpenWebsite%",
        "icon": "$(globe)"
      },
      {
        "command": "arduinoCli.lib.openExample",
        "title": "%command.libOpenExample%",
        "icon": "$(file-code)"
      },
      {
        "command": "arduinoCli.lib.addToProfile",
        "title": "%command.libAddToProfile%",
        "icon": "$(pin)"
      },
      {
        "command": "arduinoCli.profileLib.remove",
        "title": "%command.profileLibRemove%",
        "icon": "$(trash)"
      },
      {
        "command": "arduinoCli.refreshProfileLibraries",
        "title": "%command.refreshProfileLibraries%",
        "icon": "$(refresh)"
      },
      {
        "command": "arduinoCli.showVersion",
        "title": "%command.showVersion%"
      },
      {
        "command": "arduinoCli.restartDaemon",
        "title": "%command.restartDaemon%"
      },
      {
        "command": "arduinoCli.installArduinoSkill",
        "title": "%command.installArduinoSkill%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arduinoCli",
          "title": "%viewContainer.arduino%",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "arduinoCli": [
        {
          "id": "arduinoCli.platforms",
          "name": "%view.platforms%"
        },
        {
          "id": "arduinoCli.libraries",
          "name": "%view.libraries%"
        },
        {
          "id": "arduinoCli.profileLibraries",
          "name": "%view.profileLibraries%",
          "when": "arduinoCli.profileMode"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "arduinoCli.addLibrary",
          "when": "view == arduinoCli.libraries",
          "group": "navigation@0"
        },
        {
          "command": "arduinoCli.refreshLibraries",
          "when": "view == arduinoCli.libraries",
          "group": "navigation@1"
        },
        {
          "command": "arduinoCli.upgradeLibraries",
          "when": "view == arduinoCli.libraries",
          "group": "navigation@2"
        },
        {
          "command": "arduinoCli.installLibraryZip",
          "when": "view == arduinoCli.libraries",
          "group": "1_install@1"
        },
        {
          "command": "arduinoCli.installLibraryGit",
          "when": "view == arduinoCli.libraries",
          "group": "1_install@2"
        },
        {
          "command": "arduinoCli.downloadLibrary",
          "when": "view == arduinoCli.libraries",
          "group": "1_install@3"
        },
        {
          "command": "arduinoCli.refreshProfileLibraries",
          "when": "view == arduinoCli.profileLibraries",
          "group": "navigation@0"
        },
        {
          "command": "arduinoCli.installPlatform",
          "when": "view == arduinoCli.platforms",
          "group": "navigation@0"
        },
        {
          "command": "arduinoCli.refreshPlatforms",
          "when": "view == arduinoCli.platforms",
          "group": "navigation@1"
        },
        {
          "command": "arduinoCli.upgradePlatforms",
          "when": "view == arduinoCli.platforms",
          "group": "navigation@2"
        },
        {
          "command": "arduinoCli.downloadPlatform",
          "when": "view == arduinoCli.platforms",
          "group": "1_install@1"
        }
      ],
      "view/item/context": [
        {
          "command": "arduinoCli.platform.upgrade",
          "when": "view == arduinoCli.platforms && viewItem == arduinoPlatformInstalledUpdatable",
          "group": "inline@1"
        },
        {
          "command": "arduinoCli.platform.uninstall",
          "when": "view == arduinoCli.platforms && viewItem =~ /^arduinoPlatformInstalled/",
          "group": "inline@2"
        },
        {
          "command": "arduinoCli.platform.changeVersion",
          "when": "view == arduinoCli.platforms && viewItem =~ /^arduinoPlatformInstalled/",
          "group": "1_platform@1"
        },
        {
          "command": "arduinoCli.lib.addToProfile",
          "when": "view == arduinoCli.libraries && arduinoCli.profileMode && viewItem =~ /^arduinoLibInstalled/",
          "group": "inline@0"
        },
        {
          "command": "arduinoCli.lib.upgrade",
          "when": "view == arduinoCli.libraries && viewItem =~ /^arduinoLibInstalledUpdatable/",
          "group": "inline@1"
        },
        {
          "command": "arduinoCli.lib.uninstall",
          "when": "view == arduinoCli.libraries && viewItem =~ /^arduinoLibInstalled/",
          "group": "inline@2"
        },
        {
          "command": "arduinoCli.lib.openExample",
          "when": "view == arduinoCli.libraries && viewItem =~ /hasEx/",
          "group": "1_lib@1"
        },
        {
          "command": "arduinoCli.lib.openWebsite",
          "when": "view == arduinoCli.libraries && viewItem =~ /hasWeb/",
          "group": "1_lib@2"
        },
        {
          "command": "arduinoCli.lib.changeVersion",
          "when": "view == arduinoCli.libraries && viewItem =~ /^arduinoLibInstalled/",
          "group": "1_lib@3"
        },
        {
          "command": "arduinoCli.profileLib.remove",
          "when": "view == arduinoCli.profileLibraries && viewItem == arduinoProfileLib",
          "group": "inline@0"
        }
      ],
      "commandPalette": [
        {
          "command": "arduinoCli.lib.openWebsite",
          "when": "false"
        },
        {
          "command": "arduinoCli.lib.openExample",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "arduinoCli.compile",
          "when": "resourceExtname == .ino",
          "group": "navigation@1"
        },
        {
          "command": "arduinoCli.upload",
          "when": "resourceExtname == .ino",
          "group": "navigation@2"
        },
        {
          "command": "arduinoCli.openMonitor",
          "when": "resourceExtname == .ino",
          "group": "navigation@3"
        },
        {
          "command": "arduinoCli.debug",
          "when": "resourceExtname == .ino && arduinoCli.debugSupported",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "arduinoCli.path": {
          "type": "string",
          "default": "arduino-cli",
          "description": "%config.path%"
        },
        "arduinoCli.daemonPort": {
          "type": "number",
          "default": 50051,
          "description": "%config.daemonPort%"
        },
        "arduinoCli.monitor.autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "%config.monitorAutoReconnect%"
        },
        "arduinoCli.monitor.lineEnding": {
          "type": "string",
          "enum": ["none", "lf", "cr", "crlf"],
          "default": "lf",
          "description": "%config.monitorLineEnding%"
        },
        "arduinoCli.autoInstallPlatform": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoInstallPlatform%"
        },
        "arduinoCli.boardManagerUrls": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "%config.boardManagerUrls%"
        },
        "arduinoCli.alwaysExportBinaries": {
          "type": "boolean",
          "default": false,
          "description": "%config.alwaysExportBinaries%"
        },
        "arduinoCli.unsafeLibraryInstall": {
          "type": "boolean",
          "default": false,
          "description": "%config.unsafeLibraryInstall%"
        },
        "arduinoCli.updateNotifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.updateNotifications%"
        },
        "arduinoCli.debug.adapter": {
          "type": "string",
          "default": "auto",
          "description": "%config.debugAdapter%"
        },
        "arduinoCli.debug.adapterConfig": {
          "type": "object",
          "default": {},
          "description": "%config.debugAdapterConfig%"
        },
        "arduinoCli.debug.interpreter": {
          "type": "string",
          "default": "",
          "description": "%config.debugInterpreter%"
        },
        "arduinoCli.verbose": {
          "type": "boolean",
          "default": false,
          "description": "%config.verbose%"
        },
        "arduinoCli.intellisense.autoConfigure": {
          "type": "boolean",
          "default": true,
          "description": "%config.intellisenseAutoConfigure%"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "arduino-cli-build-status",
        "tags": ["arduino"],
        "toolReferenceName": "arduinoBuildStatus",
        "canBeReferencedInPrompt": true,
        "displayName": "Arduino: Build Status",
        "modelDescription": "Report the current Arduino build context: the selected board/FQBN/port (and whether the sketch is in profile mode), the installed cores and libraries, and whether C/C++ IntelliSense is configured. Call this first when diagnosing a compile/upload/IntelliSense problem to learn the state of the world.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "arduino-cli-compile",
        "tags": ["arduino"],
        "toolReferenceName": "arduinoCompile",
        "canBeReferencedInPrompt": true,
        "displayName": "Arduino: Compile",
        "modelDescription": "Compile the Arduino sketch and return the result: success/failure, the FQBN used, structured compiler diagnostics (file/line/column/severity/message), and a tail of the compiler output on failure. Use this to reproduce a build error before fixing it, and again afterwards to verify the fix.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sketch_path": {
              "type": "string",
              "description": "Path to the sketch (.ino) or sketch folder. Omit to use the active editor / the single sketch in the workspace."
            }
          }
        }
      },
      {
        "name": "arduino-cli-board-search",
        "tags": ["arduino"],
        "toolReferenceName": "arduinoBoardSearch",
        "canBeReferencedInPrompt": true,
        "displayName": "Arduino: Search Boards",
        "modelDescription": "Search the Arduino board index by name or keyword. Returns matching board names and their FQBNs (use the FQBN with board-details, or to select/compile for a board).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Board name or keyword, e.g. \"uno\", \"esp32\", \"nano 33\"."
            }
          },
          "required": ["query"]
        }
      },
      {
        "name": "arduino-cli-board-details",
        "tags": ["arduino"],
        "toolReferenceName": "arduinoBoardDetails",
        "canBeReferencedInPrompt": true,
        "displayName": "Arduino: Board Details",
        "modelDescription": "Get details for a board by FQBN: full name, platform/core, configurable options (e.g. CPU speed), and available programmers.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fqbn": {
              "type": "string",
              "description": "Fully Qualified Board Name, e.g. \"arduino:avr:uno\" or \"esp32:esp32:esp32\"."
            }
          },
          "required": ["fqbn"]
        }
      },
      {
        "name": "arduino-cli-library-search",
        "tags": ["arduino"],
        "toolReferenceName": "arduinoLibrarySearch",
        "canBeReferencedInPrompt": true,
        "displayName": "Arduino: Search Libraries",
        "modelDescription": "Search the Arduino library index by name or keyword. Returns library names, latest versions and one-line descriptions. Use this to find the exact library name before installing (e.g. to fix a 'No such file' include error).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Library name or keyword, e.g. \"servo\", \"adafruit gfx\", \"wifi\"."
            }
          },
          "required": ["query"]
        }
      },
      {
        "name": "arduino-cli-library-install",
        "tags": ["arduino"],
        "toolReferenceName": "arduinoLibraryInstall",
        "canBeReferencedInPrompt": true,
        "displayName": "Arduino: Install Library",
        "modelDescription": "Install an Arduino library by exact name (optionally a specific version) via the daemon, with dependencies by default. Use the name from library-search. Mutates the system; the user is asked to confirm.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Exact library name as returned by library-search."
            },
            "version": {
              "type": "string",
              "description": "Specific version to install. Omit for the latest."
            },
            "no_deps": {
              "type": "boolean",
              "description": "Skip installing dependencies (default false)."
            }
          },
          "required": ["name"]
        }
      },
      {
        "name": "arduino-cli-platform-install",
        "tags": ["arduino"],
        "toolReferenceName": "arduinoPlatformInstall",
        "canBeReferencedInPrompt": true,
        "displayName": "Arduino: Install Core",
        "modelDescription": "Install a board platform/core (e.g. for a new board's FQBN) via the daemon. Mutates the system; the user is asked to confirm.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "platform_package": {
              "type": "string",
              "description": "Package/vendor id, the first FQBN segment, e.g. \"arduino\" or \"esp32\"."
            },
            "architecture": {
              "type": "string",
              "description": "Architecture, the second FQBN segment, e.g. \"avr\" or \"esp32\"."
            },
            "version": {
              "type": "string",
              "description": "Specific version to install. Omit for the latest."
            }
          },
          "required": ["platform_package", "architecture"]
        }
      },
      {
        "name": "arduino-cli-upload",
        "tags": ["arduino"],
        "toolReferenceName": "arduinoUpload",
        "canBeReferencedInPrompt": true,
        "displayName": "Arduino: Upload",
        "modelDescription": "Compile the sketch and, if it succeeds, upload it to the connected board on the selected port. Returns success or the upload output on failure. Mutates hardware; the user is asked to confirm.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sketch_path": {
              "type": "string",
              "description": "Path to the sketch (.ino) or sketch folder. Omit to use the active editor / the single sketch in the workspace."
            }
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "arduino",
        "label": "Arduino Debug",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "fqbn": {
                "type": "string",
                "description": "%debug.fqbn%"
              },
              "programmer": {
                "type": "string",
                "description": "%debug.programmer%"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "arduino",
            "request": "launch",
            "name": "Arduino Debug"
          }
        ],
        "configurationSnippets": [
          {
            "label": "%debug.snippetLabel%",
            "description": "%debug.snippetDescription%",
            "body": {
              "type": "arduino",
              "request": "launch",
              "name": "Arduino Debug"
            }
          }
        ]
      }
    ],
    "walkthroughs": [
      {
        "id": "arduinoCli.welcome",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "installCli",
            "title": "%walkthrough.installCli.title%",
            "description": "%walkthrough.installCli.description%",
            "media": { "svg": "images/walkthrough/install-cli.svg", "altText": "A terminal installing arduino-cli" },
            "completionEvents": ["onCommand:arduinoCli.showVersion"]
          },
          {
            "id": "openSketch",
            "title": "%walkthrough.openSketch.title%",
            "description": "%walkthrough.openSketch.description%",
            "media": { "svg": "images/walkthrough/open-sketch.svg", "altText": "An Arduino sketch file" },
            "completionEvents": ["onCommand:arduinoCli.newSketch"]
          },
          {
            "id": "selectBoard",
            "title": "%walkthrough.selectBoard.title%",
            "description": "%walkthrough.selectBoard.description%",
            "media": { "svg": "images/walkthrough/select-board.svg", "altText": "Selecting an Arduino board" },
            "completionEvents": ["onCommand:arduinoCli.selectBoard"]
          },
          {
            "id": "compileUpload",
            "title": "%walkthrough.compileUpload.title%",
            "description": "%walkthrough.compileUpload.description%",
            "media": { "svg": "images/walkthrough/compile-upload.svg", "altText": "Compile and upload toolbar buttons" },
            "completionEvents": ["onCommand:arduinoCli.compile"]
          },
          {
            "id": "monitor",
            "title": "%walkthrough.monitor.title%",
            "description": "%walkthrough.monitor.description%",
            "media": { "svg": "images/walkthrough/monitor.svg", "altText": "Serial monitor and plotter" },
            "completionEvents": ["onCommand:arduinoCli.openMonitor"]
          },
          {
            "id": "manage",
            "title": "%walkthrough.manage.title%",
            "description": "%walkthrough.manage.description%",
            "media": { "svg": "images/walkthrough/manage.svg", "altText": "Cores and libraries sidebar" },
            "completionEvents": ["onView:arduinoCli.libraries"]
          },
          {
            "id": "blockly",
            "title": "%walkthrough.blockly.title%",
            "description": "%walkthrough.blockly.description%",
            "media": { "svg": "images/walkthrough/blockly.svg", "altText": "Drag-and-drop blocks generating Arduino code" },
            "completionEvents": ["extensionInstalled:linucs.blocks-editor"]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && yarn run check-l10n && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && yarn run check-l10n && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "check-l10n": "node scripts/check-l10n.js",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "ovsx": "^0.10.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.13"
  }
}
